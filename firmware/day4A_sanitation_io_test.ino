#include <Servo.h>
const int PIN_WATER_AVAILABLE=28, PIN_DRAIN_AVAILABLE=29, PIN_LEAK_DETECTED=36;
const int PIN_WASTE_SERVO=7, PIN_FLUSH_OUTPUT=32, PIN_RINSE_OUTPUT=33, PIN_DRAIN_OUTPUT=34, PIN_SANITATION_LED=35;
Servo wasteValve;
void allOff(){digitalWrite(PIN_FLUSH_OUTPUT,LOW);digitalWrite(PIN_RINSE_OUTPUT,LOW);digitalWrite(PIN_DRAIN_OUTPUT,LOW);digitalWrite(PIN_SANITATION_LED,LOW);} 
void setup(){Serial.begin(115200);pinMode(PIN_WATER_AVAILABLE,INPUT);pinMode(PIN_DRAIN_AVAILABLE,INPUT);pinMode(PIN_LEAK_DETECTED,INPUT);pinMode(PIN_FLUSH_OUTPUT,OUTPUT);pinMode(PIN_RINSE_OUTPUT,OUTPUT);pinMode(PIN_DRAIN_OUTPUT,OUTPUT);pinMode(PIN_SANITATION_LED,OUTPUT);wasteValve.attach(PIN_WASTE_SERVO);wasteValve.write(0);Serial.println("DAY 4A - SANITATION I/O TEST");}
void loop(){bool water=digitalRead(PIN_WATER_AVAILABLE)==HIGH;bool drain=digitalRead(PIN_DRAIN_AVAILABLE)==HIGH;bool leak=digitalRead(PIN_LEAK_DETECTED)==HIGH;Serial.print("Water=");Serial.print(water?"YES":"NO");Serial.print(" | Drain=");Serial.print(drain?"YES":"NO");Serial.print(" | Leak=");Serial.println(leak?"YES":"NO");allOff();wasteValve.write(0);delay(800);digitalWrite(PIN_SANITATION_LED,HIGH);wasteValve.write(90);digitalWrite(PIN_DRAIN_OUTPUT,HIGH);delay(1000);digitalWrite(PIN_DRAIN_OUTPUT,LOW);digitalWrite(PIN_FLUSH_OUTPUT,HIGH);delay(1000);digitalWrite(PIN_FLUSH_OUTPUT,LOW);digitalWrite(PIN_RINSE_OUTPUT,HIGH);delay(1000);digitalWrite(PIN_RINSE_OUTPUT,LOW);digitalWrite(PIN_DRAIN_OUTPUT,HIGH);delay(1000);digitalWrite(PIN_DRAIN_OUTPUT,LOW);wasteValve.write(0);digitalWrite(PIN_SANITATION_LED,LOW);delay(1500);}